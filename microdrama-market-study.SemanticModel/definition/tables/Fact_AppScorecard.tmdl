	partition Fact_AppScorecard = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Fact_AppScorecard.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"App", type text}, {"Revenue 2025 USD M", type number}, {"Downloads 2025 M", type number}, {"Avg MAU 2025 M", type number}, {"Revenue Q1 2026 USD M", type number}, {"Revenue QoQ", type number}, {"IAP Share", type number}, {"Ad Share", type number}, {"US Revenue 2025 USD M", type number}}, "en-US")
				in
