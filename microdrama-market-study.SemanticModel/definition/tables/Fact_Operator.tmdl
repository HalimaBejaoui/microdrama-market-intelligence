	partition Fact_Operator = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Fact_Operator.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Company", type text}, {"Main Apps", type text}, {"Revenue USD M", type number}, {"Net Profit USD M", type number}, {"Marketing Share", type number}, {"Market Cap USD M", type number}, {"Basis", type text}}, "en-US")
				in
				    Typed

		annotation PBI_ResultType = Table

