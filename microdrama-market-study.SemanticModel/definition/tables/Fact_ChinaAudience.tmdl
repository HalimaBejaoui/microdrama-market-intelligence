/// China microdrama viewers by age group, 2025. DataEye.
table Fact_ChinaAudience
	lineageTag: 96e5a333-a09b-54c0-9beb-4415388751d4

	column 'Age Group'
		dataType: string
		lineageTag: d7255b89-be21-51ba-afd0-fb517dc16d1e
		summarizeBy: none
		sourceColumn: Age Group
		sortByColumn: 'Age Order'

		annotation SummarizationSetBy = User

	column 'Age Order'
		dataType: int64
		isHidden
		lineageTag: a98d6e16-42ca-598a-9e10-cefa25384a24
		summarizeBy: none
		sourceColumn: Age Order

		annotation SummarizationSetBy = User

	column Share
		dataType: double
		isHidden
		lineageTag: 158233a4-c978-5e1d-a0b1-b39ba96d09b8
		summarizeBy: none
		sourceColumn: Share

		annotation SummarizationSetBy = User

	partition Fact_ChinaAudience = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "Fact_ChinaAudience.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Age Group", type text}, {"Age Order", Int64.Type}, {"Share", type number}}, "en-US")
				in
				    Typed

		annotation PBI_ResultType = Table

